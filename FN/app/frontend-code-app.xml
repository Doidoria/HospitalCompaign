            {/* 컨디션 뱃지 개선 */}
            <div className="mt-5 flex items-center gap-2.5 bg-black/20 p-3.5 rounded-2xl border border-white/5 backdrop-blur-md relative z-10">
              <span className="text-indigo-200 text-sm font-bold ml-1">당일 환자 컨디션</span>
