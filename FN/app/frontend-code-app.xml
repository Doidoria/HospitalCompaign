        </div>

        {/* 메인 콘텐츠 영역 */}
        <div className="bg-white rounded-[32px] shadow-sm border border-gray-100 p-6 md:p-10 min-h-[500px] flex flex-col">
          <AnimatePresence mode="wait">
            {activeTab === 'faq' && (
