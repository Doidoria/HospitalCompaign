          detailedContent: (document.getElementById('proxy-detail') as HTMLTextAreaElement).value,
          doctorInquiry: (document.getElementById('proxy-inquiry') as HTMLTextAreaElement).value,
          memo: "재방문 대리 신청"
        };
      }
    });

    if (formValues) {
